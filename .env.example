# Local Compose. Use a strong random password.
QUERYSTEP_DB_PASSWORD=
# Optional for Compose or a local API process.
QUERYSTEP_LLM_BASE_URL=
QUERYSTEP_LLM_MODEL=
QUERYSTEP_LLM_API_KEY=
QUERYSTEP_LLM_TIMEOUT_SECONDS=10
QUERYSTEP_LLM_TRANSIENT_RETRIES=2
# Optional diagnosis/workbench model overrides on the same gateway.
QUERYSTEP_EXPLANATION_MODEL=
QUERYSTEP_COACH_MODEL=
# Plain HTTP is an explicit opt-in for trusted testing networks.
QUERYSTEP_LLM_ALLOW_INSECURE_HTTP=0
# Local API or authorized Docker deployment. Enable after confirming mapped-item text may reach the provider.
QUERYSTEP_LLM_ALLOW_MAPPED_ITEMS=0

# 诊断与旧版错题教练（主推 SQL 实作工作台；旧版 Q75/Q81 错题教练默认关闭，按需开启）
QUERYSTEP_DIAGNOSTICS_ENABLED=1
QUERYSTEP_COACH_ENABLED=0

# 本地运行时的知识索引和向量模型路径
QUERYSTEP_KNOWLEDGE_INDEX=
QUERYSTEP_EMBEDDING_MODEL=

# Docker Compose 启用已授权 EpiKT 权重与知识索引时的容器内路径（通过只读卷 ./artifacts:/app/artifacts:ro 挂载）
# QUERYSTEP_DOCKER_CATALOG=/app/artifacts/dbe-sql-approved.json
# QUERYSTEP_DOCKER_EPIKT_RUN=/app/artifacts/epikt-dbe-fold0
# QUERYSTEP_DOCKER_KNOWLEDGE_INDEX=/app/artifacts/workbench-knowledge.sqlite3
# QUERYSTEP_DOCKER_EMBEDDING_MODEL=
