# Local Compose. Use a strong random password.
QUERYSTEP_DB_PASSWORD=
# Optional for Compose or a local API process.
QUERYSTEP_LLM_BASE_URL=
QUERYSTEP_LLM_MODEL=
QUERYSTEP_LLM_API_KEY=
QUERYSTEP_LLM_TIMEOUT_SECONDS=5
# Optional diagnosis follow-up on the same gateway. Empty disables follow-up.
QUERYSTEP_EXPLANATION_MODEL=gemini-3-flash
# Plain HTTP is an explicit opt-in for trusted testing networks.
QUERYSTEP_LLM_ALLOW_INSECURE_HTTP=0
# Local API only. Enable after confirming mapped-item text may reach the provider.
QUERYSTEP_LLM_ALLOW_MAPPED_ITEMS=0
